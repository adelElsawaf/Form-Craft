logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "formcraft_logs" {
  path_targets = [
    { __path__ = "/var/log/formcraft-root/*.log" },
    { __path__ = "/var/log/formcraft-auth/*.log" },
    { __path__ = "/var/log/formcraft-gateway/*.log" },
  ]
}

loki.source.file "formcraft" {
  targets    = local.file_match.formcraft_logs.targets
  forward_to = [loki.process.formcraft.receiver]
}

loki.process "formcraft" {
  // Only two apps: auth | gateway-server (from filename)
  stage.regex {
    source     = "filename"
    expression = `/(?P<app>auth|gateway-server)\.log$`
  }

  stage.labels {
    values = {
      app = "app",
    }
  }

  // Drop noisy auto-labels so Explore only shows app=auth|gateway-server
  stage.label_drop {
    values = ["filename", "job", "detected_level", "service_name"]
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
